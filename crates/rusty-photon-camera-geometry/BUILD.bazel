load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# No `all_crate_deps` and no `aliases`: this crate has no dependencies at all,
# first- or third-party, and keeping the dep lists literally empty is what makes
# that visible at the build level rather than only in Cargo.toml. Nothing here
# is platform-conditional either, so the target is identical on Linux, macOS and
# Windows — worth stating, because the macOS leg runs post-merge rather than on
# the PR gate.
rust_library(
    name = "rusty-photon-camera-geometry",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "rusty_photon_camera_geometry",
    edition = "2021",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "rusty-photon-camera-geometry_unit_test",
    size = "small",
    crate = ":rusty-photon-camera-geometry",
)

# The public functions carry runnable examples, and those examples are the
# shortest statement of each rule's contract — so they are compiled and run
# rather than left to the nightly Cargo safety net.
rust_doc_test(
    name = "rusty-photon-camera-geometry_doc_test",
    crate = ":rusty-photon-camera-geometry",
)
